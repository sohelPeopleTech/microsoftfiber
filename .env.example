# Copy to .env and fill in. Never commit the filled-in copy.
# Nothing in this repo reads a credential from anywhere except the environment.

# --- Web application sign-in -------------------------------------------------
# APP_USERS is "username:salt:hash" entries, comma separated. Mint them with:
#   python3 -c "import sys; sys.path.insert(0,'webapp'); import auth; \
#               print(':'.join(auth.hash_password('YOUR-PASSWORD')))"
# Unset, the app serves a built-in demo account and warns loudly at startup.
APP_USERS=
# Signs the session cookie. Unset, a per-process key is generated and every
# restart logs everyone out. Put the real one in Key Vault.
APP_SECRET_KEY=

# --- LLM (optional: wording only, never figures) -----------------------------
# Azure AI Foundry, OpenAI-compatible v1 surface. The /openai/v1 suffix is what
# selects this request shape (model in the body, bearer auth, no api-version).
AZURE_FOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1
AZURE_FOUNDRY_DEPLOYMENT=<your-deployment-name>
AZURE_FOUNDRY_API_KEY=

# Classic Azure OpenAI works too -- used only if the FOUNDRY vars are unset.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=
# Preferred inside Fabric: a managed identity avoids a stored key entirely.
AZURE_OPENAI_AD_TOKEN=

# --- Fabric (used by the notebook / pipeline, not by the local run) ----------
FABRIC_WORKSPACE_ID=
FABRIC_LAKEHOUSE_ID=
FABRIC_LAKEHOUSE_NAME=
